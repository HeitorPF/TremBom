<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>

  <link rel="stylesheet" href="../index.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">

</head>

<body>

  <nav class="navbar navbar-expand-lg fixed-div" style="background-color: rgba(0, 0, 0, 0.9); color: white;">

    <div class="container-fluid">


      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarSupportedContent">

        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Restaurantes
            </a>

            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="#">Estação</a></li>
              <li><a class="dropdown-item" href="#">Dona Benta</a></li>
              <li>
                <hr class="dropdown-divider">
              </li>
              <li><a class="dropdown-item" href="#">Something else here</a></li>
            </ul>

          </li>

          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Produtos
            </a>

            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="#">Bebidas</a></li>
              <li><a class="dropdown-item" href="#">Salgados</a></li>
              <li>
                <hr class="dropdown-divider">
              </li>
              <li><a class="dropdown-item" href="#">Something else here</a></li>
            </ul>

          </li>

          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Categorias
            </a>

            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="#">Comida Japonesa</a></li>
              <li><a class="dropdown-item" href="#">Comida Artesanal</a></li>
              <li>
                <hr class="dropdown-divider">
              </li>
              <li><a class="dropdown-item" href="#">Something else here</a></li>
            </ul>

          </li>

        </ul>

        <div class="d-flex" role="search">

          <form action="/logout" method="GET" style="margin: 0;">
            <button class="btn btn-outline-danger" type="submit" style=" padding: 5px">Logout</button>
          </form>
        </div>

      </div>

    </div>

  </nav>

  <div>
    <div class="logotipo">
      <img src="../assets/logo.png" alt="">
      <h3>TremBom</h3>
    </div>
  </div>


  <div class="container">
    <div class="content-carousel" id="listaProdutos">

       
    {{#each produto}}
    <div class="card" style="width: 18rem;">
      <div class="card-body">

        <div class="item">
          <div class="container-imagem-produto">
            <img class="imagem-produto" src="assets/{{urlImagem}}" alt="{{nome}}">
          </div>
          
          <p class="nome-produto">{{nome}}</p>
          <p class="preco-produto"><strong>R${{preco}}</strong></p>
          <a href="#" class="btn btn-primary btn-pedido" data-id="{{_id}}">Adicionar ao carrinho</a>

        </div>

      </div>
    </div>

    {{/each}}


    </div>
  </div>

  

  <div class="container">
    <form id="pedidoForm" action="/realizar-pedido" method="post">
      <div class="form-group">
        <label for="inputItens">Usuário: {{usuario}}</label>
      </div>
      <div class="form-group">
        <label for="inputQuantidade">Quantidade</label>
      </div>
      <div class="form-group">
        <label for="exampleInputPassword1">Total</label>
      </div>

      <div class="button-form">
        <button type="submit" class="btn btn-primary">Finalizar Pedido</button>

      </div>

    </form>
  </div>

  <footer>

    <div class="footer-content">
      <p>Desenvolvido por Brena Freitas e Heitor da Piedade</p>
      <p>2025</p>
    </div>

  </footer>


  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script src="../pedido.js"></script>
</body>

</html>